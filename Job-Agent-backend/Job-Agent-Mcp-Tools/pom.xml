<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.job</groupId>
        <artifactId>Job-Agent-backend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>Job-Agent-Mcp-Tools</artifactId>
    <name>Job-Agent-Mcp-Tools</name>
    <description>Agent 工具层：封装简历分析、岗位搜索、岗位匹配、公司分析等可调用工具</description>

    <dependencies>
        <!-- 内部模块：复用统一返回、异常、Trace 和工具上下文 -->
        <dependency>
            <groupId>com.job</groupId>
            <artifactId>Job-Agent-Framework</artifactId>
        </dependency>

        <!-- 内部模块：工具通过领域服务访问用户、简历、岗位、公司和收藏数据 -->
        <dependency>
            <groupId>com.job</groupId>
            <artifactId>Job-Agent-Domain</artifactId>
        </dependency>

        <!-- 内部模块：工具调用 AI 能力完成评分、匹配、公司分析和打招呼语生成 -->
        <dependency>
            <groupId>com.job</groupId>
            <artifactId>Job-Agent-Infra-Ai</artifactId>
        </dependency>

        <!-- Spring 基础容器：将 Tool、Registry 和工具适配器注册为 Bean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 参数校验：工具入参、筛选条件和业务命令对象校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- LangChain4j 核心：提供 @Tool、@P、ToolSpecification 等工具调用注解和模型交互类型 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- Hutool：工具层常用集合、字符串、JSON 和对象处理 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- Lombok：简化工具请求、响应和注册器代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test：Agent 工具单测和工具注册测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
