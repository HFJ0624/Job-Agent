<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.job</groupId>
        <artifactId>Job-Agent-backend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>Job-Agent-Bootstrap</artifactId>
    <name>Job-Agent-Bootstrap</name>
    <description>启动模块：应用入口、Controller 接口和全局配置装配</description>

    <dependencies>
        <!-- 内部模块：通用框架能力，提供统一返回、异常、Trace、Redis、SSE 等基础设施 -->
        <dependency>
            <groupId>com.job</groupId>
            <artifactId>Job-Agent-Framework</artifactId>
        </dependency>

        <!-- Spring Web：提供 REST Controller、文件上传和 SSE HTTP 接口能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring JDBC：RAG 向量库单独使用 JdbcTemplate 连接 PostgreSQL/pgvector，不影响主业务 MySQL 数据源 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 参数校验：Controller 入参、DTO 和配置属性校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator：运行状态、健康检查和后续模型调用指标观测 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI UI：生成 Swagger 接口文档，方便前后端联调 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- MySQL 驱动：启动模块运行时连接 MySQL 8 数据库 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL 驱动：连接 application-local.yml 中配置的 pgvector 数据库 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis-Plus Boot3：Controller 调用领域服务时需要完整 ORM 自动装配 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MyBatis-Plus JSqlParser：分页插件需要用它解析分页 SQL -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- Sa-Token：启动模块暴露登录、退出和鉴权接口时使用 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Spring Security Crypto：只使用 BCrypt 加密密码，不接入完整 Spring Security 登录体系 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- MinIO SDK：注册头像、简历等文件上传到对象存储 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- Apache Tika Core：统一入口，自动识别 PDF、DOC、DOCX 等简历文件类型 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>

        <!-- Apache Tika 标准解析器包：提供 Word、PDF 等常见文档的文本抽取实现 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>

        <!-- Apache POI OOXML：Tika 解析 DOCX 简历时会使用到 Office 文档处理能力 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Apache PDFBox：Tika 解析 PDF 简历时会使用到 PDF 文本抽取能力 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Lombok：减少启动配置、Controller DTO 等样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 配置元数据处理器：为 application.yml 配置项生成 IDE 提示 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test：启动模块集成测试和 Web 层测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.job</groupId>
            <artifactId>Job-Agent-Infra-Ai</artifactId>
        </dependency>

        <!-- 外部连接器工具模块：招聘平台、邮箱、日历、通知、简历导出、岗位来源同步等 Agent 工具 -->
        <dependency>
            <groupId>com.job</groupId>
            <artifactId>Job-Agent-Mcp-Tools</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Bootstrap 是唯一启动模块，需要打成可执行 Spring Boot Jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
